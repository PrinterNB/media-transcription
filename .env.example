# Copy to .env and fill in. All values optional; sensible defaults shown.

# Hugging Face token — REQUIRED for pyannote/speaker-diarization-3.1 (gated).
# Get one at https://huggingface.co/settings/tokens after accepting the
# pyannote model terms at https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=

# Ollama server (same machine by default)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen-ultrafast

# Where uploads/outputs/db live. Override to keep GBs out of a OneDrive folder.
DATA_DIR=data

# Folder of manually-downloaded models (README "Option B") — each subfolder
# (faster-whisper-large-v3/, pyannote-speaker-diarization-3.1/,
# canary-qwen-2.5b/) takes priority over the Hugging Face hub. Optional.
MODELS_DIR=models

# ASR default (canary|whisper). Canary = English only, recommended.
ASR_DEFAULT=canary

# Model ids / sizes
CANARY_MODEL=nvidia/canary-qwen-2.5b
WHISPER_MODEL=large-v3
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1

# Host/port the API + web UI bind to (0.0.0.0 so LAN devices can reach it)
HOST=0.0.0.0
PORT=8000
